<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/soft_screen_bg">

    <ScrollView
        android:id="@+id/settingsScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="122dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/backButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:minWidth="0dp"
                    android:paddingHorizontal="0dp"
                    android:text="Back"
                    android:textAllCaps="false"
                    android:textColor="@color/soft_text_secondary"
                    android:textSize="16sp"
                    app:icon="@drawable/ic_arrow_back"
                    app:iconPadding="8dp"
                    app:iconTint="@color/soft_text_secondary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="PHANToM GO Settings"
                    android:textColor="@color/soft_text_primary"
                    android:textSize="26sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="จัดการการแจ้งเตือน, เครื่องจอ, เครื่องหลัก และระบบ log ในหน้าเดียว"
                android:textColor="@color/soft_text_muted"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/soft_card_background"
                android:elevation="3dp"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Notifications"
                    android:textColor="@color/soft_text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="เปิดไว้เพื่อให้ foreground service, cloud alerts และการส่งเส้นทางทำงานได้เสถียร"
                    android:textColor="@color/soft_text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/notificationStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Checking..."
                    android:textColor="@color/soft_text_secondary"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/requestNotificationButton"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/soft_primary_button"
                    android:text="Enable Notifications"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/soft_card_background"
                android:elevation="3dp"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Display Device"
                    android:textColor="@color/soft_text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="ตั้งค่าส่วนนี้บนเครื่องที่ใช้เป็นจอติดรถและรับปลายทางจากเครื่องหลัก"
                    android:textColor="@color/soft_text_secondary"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/soft_inline_card_background"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Display Power Automation"
                        android:textColor="@color/soft_text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:layoutDirection="rtl"
                        android:orientation="horizontal">

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/displayPowerAutomationSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layoutDirection="ltr"
                            android:layout_gravity="end" />

                        <TextView
                            android:id="@+id/displayPowerAutomationStatusText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:gravity="start"
                            android:textDirection="locale"
                            android:text="Off"
                            android:textColor="@color/soft_warning"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/displayPowerAutomationDetailText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Profile details"
                        android:textColor="@color/soft_text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Wake and brighten before opening Maps"
                        android:textColor="@color/soft_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:layoutDirection="rtl"
                        android:orientation="horizontal">

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/displayWakeBeforeMapsSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layoutDirection="ltr"
                            android:layout_gravity="end" />

                        <TextView
                            android:id="@+id/displayWakeBeforeMapsStatusText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:gravity="start"
                            android:textDirection="locale"
                            android:text="Enabled"
                            android:textColor="@color/soft_success"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Lock device when external power disconnects"
                        android:textColor="@color/soft_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:layoutDirection="rtl"
                        android:orientation="horizontal">

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/lockOnDisconnectSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layoutDirection="ltr"
                            android:layout_gravity="end" />

                        <TextView
                            android:id="@+id/lockOnDisconnectStatusText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:gravity="start"
                            android:textDirection="locale"
                            android:text="Disabled"
                            android:textColor="@color/soft_text_secondary"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/systemSettingsStatusText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Modify system settings required"
                        android:textColor="@color/soft_warning"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/requestSystemSettingsButton"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/soft_secondary_button"
                        android:text="Grant Modify System Settings"
                        android:textAllCaps="false"
                        android:textColor="@color/soft_blue_dark" />

                    <TextView
                        android:id="@+id/deviceAdminStatusText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Device Admin optional"
                        android:textColor="@color/soft_text_secondary"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/requestDeviceAdminButton"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/soft_secondary_button"
                        android:text="Enable Device Admin"
                        android:textAllCaps="false"
                        android:textColor="@color/soft_blue_dark" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/soft_inline_card_background"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Overlay Widget"
                        android:textColor="@color/soft_text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:layoutDirection="rtl"
                        android:orientation="horizontal">

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/overlaySwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layoutDirection="ltr"
                            android:layout_gravity="end" />

                        <TextView
                            android:id="@+id/overlayStatusText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:gravity="start"
                            android:textDirection="locale"
                            android:text="Checking..."
                            android:textColor="@color/soft_text_secondary"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/grantPermissionButton"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/soft_secondary_button"
                        android:text="Grant Overlay Permission"
                        android:textAllCaps="false"
                        android:textColor="@color/soft_blue_dark"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/soft_inline_card_background"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Display Open Behavior"
                        android:textColor="@color/soft_text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/displayOpenModeStatusText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Preview Route"
                        android:textColor="@color/soft_blue_dark"
                        android:textSize="13sp" />

                    <RadioGroup
                        android:id="@+id/displayOpenModeGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/displayOpenModePreview"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Preview Route" />

                        <RadioButton
                            android:id="@+id/displayOpenModeNavigate"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Start Navigation" />
                    </RadioGroup>

                    <TextView
                        android:id="@+id/displayNavModeStatusText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Car"
                        android:textColor="@color/soft_blue_dark"
                        android:textSize="13sp" />

                    <RadioGroup
                        android:id="@+id/displayNavModeGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/displayNavModeCar"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Car" />

                        <RadioButton
                            android:id="@+id/displayNavModeMotorcycle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Motorcycle" />
                    </RadioGroup>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/soft_inline_card_background"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Display Speedometer"
                        android:textColor="@color/soft_text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:layoutDirection="rtl"
                        android:orientation="horizontal">

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/speedometerSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layoutDirection="ltr"
                            android:layout_gravity="end" />

                        <TextView
                            android:id="@+id/speedometerStatusText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:gravity="start"
                            android:textDirection="locale"
                            android:text="Off"
                            android:textColor="@color/soft_warning"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/speedometerPermissionText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Location permission: not granted"
                        android:textColor="@color/soft_text_secondary"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/requestLocationPermissionButton"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/soft_secondary_button"
                        android:text="Allow location and all-time access"
                        android:textAllCaps="false"
                        android:textColor="@color/soft_blue_dark" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/soft_inline_card_background"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Display Anti-Theft"
                        android:textColor="@color/soft_text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:layoutDirection="rtl"
                        android:orientation="horizontal">

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/antiTheftEnabledSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layoutDirection="ltr"
                            android:layout_gravity="end" />

                        <TextView
                            android:id="@+id/antiTheftStatusText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:gravity="start"
                            android:textDirection="locale"
                            android:text="Off"
                            android:textColor="@color/soft_warning"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/antiTheftDetailText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Waiting for a 3.5 mm trigger"
                        android:textColor="@color/soft_text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Attach location in theft alerts"
                        android:textColor="@color/soft_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:layoutDirection="rtl"
                        android:orientation="horizontal">

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/antiTheftAttachLocationSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layoutDirection="ltr"
                            android:layout_gravity="end" />

                        <TextView
                            android:id="@+id/antiTheftAttachLocationStatus"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:gravity="start"
                            android:textDirection="locale"
                            android:text="On"
                            android:textColor="@color/soft_success"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/antiTheftPinButton"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/soft_secondary_button"
                        android:text="Set / Change Anti-Theft PIN"
                        android:textAllCaps="false"
                        android:textColor="@color/soft_blue_dark" />

                    <Button
                        android:id="@+id/antiTheftSoundButton"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/soft_secondary_button"
                        android:text="Choose Alarm Sound"
                        android:textAllCaps="false"
                        android:textColor="@color/soft_blue_dark" />

                    <Button
                        android:id="@+id/antiTheftTestButton"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/soft_secondary_button"
                        android:text="Test Anti-Theft Alarm"
                        android:textAllCaps="false"
                        android:textColor="@color/soft_blue_dark" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/soft_card_background"
                android:elevation="3dp"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Main Device"
                    android:textColor="@color/soft_text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="ตั้งค่าส่วนนี้บนเครื่องที่ใช้รับลิงก์และส่งปลายทางไปยังจอ"
                    android:textColor="@color/soft_text_secondary"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/soft_inline_card_background"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Map Link Hub"
                        android:textColor="@color/soft_text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:layoutDirection="rtl"
                        android:orientation="horizontal">

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/mapLinkHubSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layoutDirection="ltr"
                            android:layout_gravity="end" />

                        <TextView
                            android:id="@+id/mapLinkHubStatusText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:gravity="start"
                            android:textDirection="locale"
                            android:text="Off"
                            android:textColor="@color/soft_warning"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/deviceModeStatusText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Device mode: MAIN"
                        android:textColor="@color/soft_text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/mapLinkHubInstructionText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="หากต้องการให้เด้งเข้า PHANToM GO อัตโนมัติ ให้ตั้งค่า Open by default ในระบบ"
                        android:textColor="@color/soft_text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/mapLinkHubDefaultStatusText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="System default: โปรดตั้งค่าในระบบ"
                        android:textColor="@color/soft_text_muted"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/openByDefaultButton"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/soft_secondary_button"
                        android:text="Open by default settings"
                        android:textAllCaps="false"
                        android:textColor="@color/soft_blue_dark" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/soft_inline_card_background"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Connection Transport"
                        android:textColor="@color/soft_text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/transportModeStatusText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Current transport: WIFI"
                        android:textColor="@color/soft_blue_dark"
                        android:textSize="13sp" />

                    <RadioGroup
                        android:id="@+id/transportModeGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp">

                        <RadioButton
                            android:id="@+id/transportModeAuto"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="AUTO" />

                        <RadioButton
                            android:id="@+id/transportModeWifi"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Wi‑Fi Local (HTTP)" />

                        <RadioButton
                            android:id="@+id/transportModeBluetooth"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Bluetooth (RFCOMM)" />
                    </RadioGroup>

                    <TextView
                        android:id="@+id/bluetoothTargetStatusText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Bluetooth transport disabled"
                        android:textColor="@color/soft_text_secondary"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/pickBluetoothDeviceButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/soft_secondary_button"
                        android:text="เลือกอุปกรณ์ Bluetooth"
                        android:textAllCaps="false"
                        android:textColor="@color/soft_blue_dark" />

                    <Button
                        android:id="@+id/clearBluetoothDeviceButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/soft_secondary_button"
                        android:text="ล้างอุปกรณ์ Bluetooth"
                        android:textAllCaps="false"
                        android:textColor="@color/soft_blue_dark"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/soft_inline_card_background"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Smart Mode"
                        android:textColor="@color/soft_text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:layoutDirection="rtl"
                        android:orientation="horizontal">

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/smartModeSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layoutDirection="ltr"
                            android:layout_gravity="end" />

                        <TextView
                            android:id="@+id/smartModeStatusText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:gravity="start"
                            android:textDirection="locale"
                            android:text="Off"
                            android:textColor="@color/soft_warning"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <RadioGroup
                        android:id="@+id/smartPolicyGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp">

                        <RadioButton
                            android:id="@+id/policyAutoSendNavOnly"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Auto Send (Nav Only)" />

                        <RadioButton
                            android:id="@+id/policyAlwaysAsk"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Always Ask" />

                        <RadioButton
                            android:id="@+id/policyAlwaysSend"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Always Send" />

                        <RadioButton
                            android:id="@+id/policyAlwaysOpenOnPhone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Always Open On Phone" />
                    </RadioGroup>

                    <RadioGroup
                        android:id="@+id/afterSendGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">

                        <RadioButton
                            android:id="@+id/afterSendExit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Exit after send" />

                        <RadioButton
                            android:id="@+id/afterSendStay"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Stay in app" />
                    </RadioGroup>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/openMapsAfterSendSwitch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Open Google Maps on Main after send"
                        android:textColor="@color/soft_text_primary" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/soft_card_background"
                android:elevation="3dp"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Logcat / System Logs"
                        android:textColor="@color/soft_text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/copyLogButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="@drawable/soft_secondary_button"
                        android:text="Copy"
                        android:textAllCaps="false"
                        android:textColor="@color/soft_blue_dark" />

                    <Button
                        android:id="@+id/clearLogButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/soft_secondary_button"
                        android:text="Clear"
                        android:textAllCaps="false"
                        android:textColor="@color/soft_blue_dark" />
                </LinearLayout>

                <ScrollView
                    android:id="@+id/logScrollView"
                    android:layout_width="match_parent"
                    android:layout_height="260dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/soft_inline_card_background"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/logText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="Loading logs..."
                        android:textColor="@color/soft_text_secondary"
                        android:textSize="12sp" />
                </ScrollView>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
