<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/aurora_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚙️ Settings"
            android:textColor="@color/aurora_cyan"
            android:textSize="32sp"
            android:textStyle="bold"
            android:layout_marginBottom="32dp" />

        <!-- Overlay Settings Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/aurora_glass"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🎯 Overlay Widget"
                    android:textColor="@color/aurora_cyan"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Show overlay widget when navigation is received and app is in background"
                    android:textColor="@color/aurora_silver"
                    android:textSize="14sp"
                    android:layout_marginBottom="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <Switch
                        android:id="@+id/overlaySwitch"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:thumbTint="@color/aurora_cyan"
                        android:trackTint="@color/aurora_gray" />

                    <TextView
                        android:id="@+id/overlayStatusText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Checking..."
                        android:textColor="@color/aurora_silver"
                        android:textSize="14sp"
                        android:layout_marginStart="16dp" />

                </LinearLayout>

                <Button
                    android:id="@+id/grantPermissionButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="🔐 Grant Overlay Permission"
                    android:textColor="@color/white"
                    android:background="@drawable/aurora_button_ripple"
                    android:visibility="gone" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Map Link Hub Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/aurora_glass"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🗺️ Map Link Hub"
                    android:textColor="@color/aurora_cyan"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="เมื่อเปิด PHANToM GO จะรับลิงก์แผนที่แทน Google Maps แล้วส่งไปเครื่องจอทันที"
                    android:textColor="@color/aurora_silver"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <Switch
                        android:id="@+id/mapLinkHubSwitch"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:thumbTint="@color/aurora_cyan"
                        android:trackTint="@color/aurora_gray" />

                    <TextView
                        android:id="@+id/mapLinkHubStatusText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Off"
                        android:textColor="@color/aurora_warning"
                        android:textSize="14sp"
                        android:layout_marginStart="16dp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/deviceModeStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Device mode: MAIN"
                    android:textColor="@color/aurora_silver"
                    android:textSize="13sp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/mapLinkHubInstructionText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="หากต้องการให้เด้งเข้า PHANToM GO อัตโนมัติ ให้ตั้งค่า Open by default ในระบบ"
                    android:textColor="@color/aurora_silver"
                    android:textSize="13sp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/mapLinkHubDefaultStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="System default: โปรดตั้งค่าในระบบ"
                    android:textColor="@color/aurora_silver"
                    android:textSize="12sp"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/openByDefaultButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⚙️ ตั้งค่า Open by default"
                    android:textColor="@color/white"
                    android:background="@drawable/aurora_button_ripple" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🔌 Connection Transport"
                    android:textColor="@color/aurora_cyan"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/transportModeStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Current transport: AUTO"
                    android:textColor="@color/aurora_cyan"
                    android:textSize="13sp"
                    android:layout_marginBottom="8dp" />

                <RadioGroup
                    android:id="@+id/transportModeGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp">

                    <RadioButton
                        android:id="@+id/transportModeAuto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:paddingVertical="12dp"
                        android:text="AUTO (Wi‑Fi ก่อน, Bluetooth สำรอง)" />

                    <RadioButton
                        android:id="@+id/transportModeWifi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:paddingVertical="12dp"
                        android:text="Wi‑Fi Local (HTTP)" />

                    <RadioButton
                        android:id="@+id/transportModeBluetooth"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:paddingVertical="12dp"
                        android:text="Bluetooth (RFCOMM)" />

                </RadioGroup>

                <TextView
                    android:id="@+id/bluetoothTargetStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="BT target: not selected"
                    android:textColor="@color/aurora_warning"
                    android:textSize="13sp"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/pickBluetoothDeviceButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📶 เลือกอุปกรณ์ Bluetooth"
                    android:textColor="@color/white"
                    android:background="@drawable/aurora_button_ripple" />

                <Button
                    android:id="@+id/clearBluetoothDeviceButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="🗑️ ล้างอุปกรณ์ Bluetooth"
                    android:textColor="@color/white"
                    android:background="@drawable/aurora_button_ripple"
                    android:visibility="gone" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="โหมดฉลาด (Smart Mode)"
                    android:textColor="@color/aurora_cyan"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <Switch
                        android:id="@+id/smartModeSwitch"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:thumbTint="@color/aurora_cyan"
                        android:trackTint="@color/aurora_gray" />

                    <TextView
                        android:id="@+id/smartModeStatusText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Off"
                        android:textColor="@color/aurora_warning"
                        android:textSize="14sp"
                        android:layout_marginStart="16dp" />

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="นโยบายโหมดฉลาด"
                    android:textColor="@color/aurora_silver"
                    android:textSize="13sp"
                    android:layout_marginBottom="8dp" />

                <RadioGroup
                    android:id="@+id/smartPolicyGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">

                    <RadioButton
                        android:id="@+id/policyAutoSendNavOnly"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:paddingVertical="12dp"
                        android:text="ส่งไปจอเฉพาะกรณีเป็นนำทาง" />

                    <RadioButton
                        android:id="@+id/policyAlwaysAsk"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:paddingVertical="12dp"
                        android:text="ถามผู้ใช้ทุกครั้ง" />

                    <RadioButton
                        android:id="@+id/policyAlwaysSend"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:paddingVertical="12dp"
                        android:text="ส่งไปจอทุกครั้ง" />

                    <RadioButton
                        android:id="@+id/policyAlwaysOpenOnPhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:paddingVertical="12dp"
                        android:text="เปิด Maps บนเครื่องหลักทุกครั้ง" />

                </RadioGroup>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="หลังส่งสำเร็จ"
                    android:textColor="@color/aurora_silver"
                    android:textSize="13sp"
                    android:layout_marginBottom="8dp" />

                <RadioGroup
                    android:id="@+id/afterSendGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">

                    <RadioButton
                        android:id="@+id/afterSendExit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:paddingVertical="12dp"
                        android:text="ปิดตัวเองและไม่อยู่ Recent" />

                    <RadioButton
                        android:id="@+id/afterSendStay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:paddingVertical="12dp"
                        android:text="ค้างใน PHANToM GO" />

                </RadioGroup>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="หลังส่งสำเร็จ: เปิด Google Maps บนเครื่องหลัก"
                    android:textColor="@color/aurora_silver"
                    android:textSize="13sp"
                    android:layout_marginBottom="8dp" />

                <Switch
                    android:id="@+id/openMapsAfterSendSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumbTint="@color/aurora_cyan"
                    android:trackTint="@color/aurora_gray" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="16dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🛵 Display Navigation Mode"
                    android:textColor="@color/aurora_cyan"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/displayNavModeStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Car"
                    android:textColor="@color/aurora_cyan"
                    android:textSize="13sp"
                    android:layout_marginBottom="8dp" />

                <RadioGroup
                    android:id="@+id/displayNavModeGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp">

                    <RadioButton
                        android:id="@+id/displayNavModeCar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:paddingVertical="12dp"
                        android:text="รถยนต์ (Car)" />

                    <RadioButton
                        android:id="@+id/displayNavModeMotorcycle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:paddingVertical="12dp"
                        android:text="มอเตอร์ไซค์ (Motorcycle)" />

                </RadioGroup>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="16dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🧭 Display Open Mode"
                    android:textColor="@color/aurora_cyan"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/displayOpenModeStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Show route preview"
                    android:textColor="@color/aurora_cyan"
                    android:textSize="13sp"
                    android:layout_marginBottom="8dp" />

                <RadioGroup
                    android:id="@+id/displayOpenModeGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp">

                    <RadioButton
                        android:id="@+id/displayOpenModePreview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:paddingVertical="12dp"
                        android:text="แสดงเส้นทางก่อน (กดเริ่มเอง)" />

                    <RadioButton
                        android:id="@+id/displayOpenModeNavigate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:paddingVertical="12dp"
                        android:text="เริ่มนำทางทันที" />

                </RadioGroup>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Notification Settings Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/aurora_glass"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🔔 Notifications"
                    android:textColor="@color/aurora_cyan"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:id="@+id/notificationStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Checking..."
                    android:textColor="@color/aurora_silver"
                    android:textSize="14sp"
                    android:layout_marginBottom="16dp" />

                <Button
                    android:id="@+id/requestNotificationButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🔔 Enable Notifications"
                    android:textColor="@color/white"
                    android:background="@drawable/aurora_button_ripple"
                    android:visibility="gone" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Logs Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/aurora_glass"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="📋 System Logs"
                        android:textColor="@color/aurora_cyan"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/copyLogButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:text="📋 Copy"
                        android:textSize="12sp"
                        android:textColor="@color/white"
                        android:minWidth="0dp"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="8dp"
                        android:background="@drawable/aurora_button_ripple" />

                    <Button
                        android:id="@+id/clearLogButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🗑️ Clear"
                        android:textSize="12sp"
                        android:textColor="@color/white"
                        android:minWidth="0dp"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="8dp"
                        android:background="@drawable/aurora_button_ripple" />

                </LinearLayout>

                <ScrollView
                    android:id="@+id/logScrollView"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@color/aurora_black"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/logText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Loading logs..."
                        android:textColor="@color/aurora_silver"
                        android:textSize="12sp"
                        android:fontFamily="monospace" />

                </ScrollView>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Back Button -->
        <Button
            android:id="@+id/backButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔙 Back"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:background="@drawable/aurora_button_ripple"
            android:layout_marginTop="16dp" />

    </LinearLayout>
</ScrollView>
