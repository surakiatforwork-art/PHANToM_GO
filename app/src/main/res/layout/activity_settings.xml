<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/aurora_bg">

    <ScrollView
        android:id="@+id/settingsScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="110dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/backButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="0dp"
                android:text="← Back"
                android:textColor="@color/aurora_cyan"
                android:textStyle="bold"
                app:icon="@drawable/ic_arrow_back"
                app:iconPadding="8dp"
                app:iconTint="@color/aurora_cyan" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Settings"
                    android:textColor="@color/aurora_cyan"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="จัดการสิทธิ์แจ้งเตือน, เครื่องจอ, เครื่องหลัก และระบบ log"
                    android:textColor="@color/aurora_silver"
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardBackgroundColor="@color/aurora_glass"
            app:cardCornerRadius="18dp"
            app:cardElevation="4dp"
            app:strokeColor="@color/aurora_cyan"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1) การแจ้งเตือน"
                    android:textColor="@color/aurora_cyan"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="ต้องเปิดไว้เพื่อให้ foreground service และการรับเส้นทางทำงานเสถียร"
                    android:textColor="@color/aurora_silver"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/notificationStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Checking..."
                    android:textColor="@color/aurora_silver"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/requestNotificationButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/aurora_button_ripple"
                    android:text="Enable Notifications"
                    android:textColor="@color/white"
                    android:visibility="gone" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardBackgroundColor="@color/aurora_glass"
            app:cardCornerRadius="18dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="3) การตั้งค่าเครื่องหลัก (Main)"
                    android:textColor="@color/aurora_cyan"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="ตั้งค่าส่วนนี้บนเครื่องที่ใช้แชร์ลิงก์และส่งปลายทางไปยังจอ"
                    android:textColor="@color/aurora_silver"
                    android:textSize="14sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="18dp"
                    android:alpha="0.45"
                    android:background="@color/aurora_gray" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Link Hub &amp; Sending"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="เมื่อเปิด PHANToM GO จะรับลิงก์แผนที่แทน Google Maps แล้วส่งไปเครื่องจอทันที"
                    android:textColor="@color/aurora_silver"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Switch
                        android:id="@+id/mapLinkHubSwitch"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:thumbTint="@color/aurora_cyan"
                        android:trackTint="@color/aurora_gray" />

                    <TextView
                        android:id="@+id/mapLinkHubStatusText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="Off"
                        android:textColor="@color/aurora_warning"
                        android:textSize="14sp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/deviceModeStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Device mode: MAIN"
                    android:textColor="@color/aurora_silver"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/mapLinkHubInstructionText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="หากต้องการให้เด้งเข้า PHANToM GO อัตโนมัติ ให้ตั้งค่า Open by default ในระบบ"
                    android:textColor="@color/aurora_silver"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/mapLinkHubDefaultStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="System default: โปรดตั้งค่าในระบบ"
                    android:textColor="@color/aurora_silver"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/openByDefaultButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/aurora_button_ripple"
                    android:text="ตั้งค่า Open by default"
                    android:textColor="@color/white" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="18dp"
                    android:alpha="0.45"
                    android:background="@color/aurora_gray" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Connection Transport"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/transportModeStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Current transport: AUTO"
                    android:textColor="@color/aurora_cyan"
                    android:textSize="13sp" />

                <RadioGroup
                    android:id="@+id/transportModeGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <RadioButton
                        android:id="@+id/transportModeAuto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:paddingVertical="12dp"
                        android:text="AUTO (Wi-Fi ก่อน, Bluetooth สำรอง)" />

                    <RadioButton
                        android:id="@+id/transportModeWifi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:paddingVertical="12dp"
                        android:text="Wi-Fi Local (HTTP)" />

                    <RadioButton
                        android:id="@+id/transportModeBluetooth"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:paddingVertical="12dp"
                        android:text="Bluetooth (RFCOMM)" />

                </RadioGroup>

                <TextView
                    android:id="@+id/bluetoothTargetStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="BT target: not selected"
                    android:textColor="@color/aurora_warning"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/pickBluetoothDeviceButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/aurora_button_ripple"
                    android:text="เลือกอุปกรณ์ Bluetooth"
                    android:textColor="@color/white" />

                <Button
                    android:id="@+id/clearBluetoothDeviceButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/aurora_button_ripple"
                    android:text="ล้างอุปกรณ์ Bluetooth"
                    android:textColor="@color/white"
                    android:visibility="gone" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardBackgroundColor="@color/aurora_glass"
            app:cardCornerRadius="18dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="2) การตั้งค่าเครื่องจอ (Display)"
                    android:textColor="@color/aurora_cyan"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="ตั้งค่าส่วนนี้บนเครื่องที่ใช้เป็นจอติดรถ"
                    android:textColor="@color/aurora_silver"
                    android:textSize="14sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="18dp"
                    android:alpha="0.45"
                    android:background="@color/aurora_gray" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Overlay Widget"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Show overlay widget when navigation is received and app is in background"
                    android:textColor="@color/aurora_silver"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Switch
                        android:id="@+id/overlaySwitch"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:thumbTint="@color/aurora_cyan"
                        android:trackTint="@color/aurora_gray" />

                    <TextView
                        android:id="@+id/overlayStatusText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="Checking..."
                        android:textColor="@color/aurora_silver"
                        android:textSize="14sp" />

                </LinearLayout>

                <Button
                    android:id="@+id/grantPermissionButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/aurora_button_ripple"
                    android:text="Grant Overlay Permission"
                    android:textColor="@color/white"
                    android:visibility="gone" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="18dp"
                    android:alpha="0.45"
                    android:background="@color/aurora_gray" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Display Navigation Mode"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/displayNavModeStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Car"
                    android:textColor="@color/aurora_cyan"
                    android:textSize="13sp" />

                <RadioGroup
                    android:id="@+id/displayNavModeGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <RadioButton
                        android:id="@+id/displayNavModeCar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:paddingVertical="12dp"
                        android:text="รถยนต์ (Car)" />

                    <RadioButton
                        android:id="@+id/displayNavModeMotorcycle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:paddingVertical="12dp"
                        android:text="มอเตอร์ไซค์ (Motorcycle)" />

                </RadioGroup>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="18dp"
                    android:alpha="0.45"
                    android:background="@color/aurora_gray" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Display Open Mode"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/displayOpenModeStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Show route preview"
                    android:textColor="@color/aurora_cyan"
                    android:textSize="13sp" />

                <RadioGroup
                    android:id="@+id/displayOpenModeGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <RadioButton
                        android:id="@+id/displayOpenModePreview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:paddingVertical="12dp"
                        android:text="แสดงเส้นทางก่อน (กดเริ่มเอง)" />

                    <RadioButton
                        android:id="@+id/displayOpenModeNavigate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:paddingVertical="12dp"
                        android:text="เริ่มนำทางทันที" />

                </RadioGroup>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="18dp"
                    android:alpha="0.45"
                    android:background="@color/aurora_gray" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Display Speedometer"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="ใช้ GPS และสิทธิ์เข้าถึงตำแหน่งเพื่อแสดงความเร็วปัจจุบันเป็น km/h ระหว่างใช้งาน Display mode"
                    android:textColor="@color/aurora_silver"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Switch
                        android:id="@+id/speedometerSwitch"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:thumbTint="@color/aurora_cyan"
                        android:trackTint="@color/aurora_gray" />

                    <TextView
                        android:id="@+id/speedometerStatusText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="Off"
                        android:textColor="@color/aurora_warning"
                        android:textSize="14sp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/speedometerPermissionText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Location permission: not granted"
                    android:textColor="@color/aurora_silver"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/requestLocationPermissionButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/aurora_button_ripple"
                    android:text="อนุญาตตำแหน่งและ All-time access"
                    android:textColor="@color/white" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="18dp"
                    android:alpha="0.45"
                    android:background="@color/aurora_gray" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Display Anti-Theft"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="ใช้งานเฉพาะกับสาย trigger ที่เสียบผ่านช่อง 3.5 mm บนเครื่องจอ เมื่อถอดสายจะให้ใส่ PIN และสามารถส่งแจ้งเตือนไปยังเครื่องหลักที่จับคู่ไว้"
                    android:textColor="@color/aurora_silver"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Switch
                        android:id="@+id/antiTheftEnabledSwitch"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:thumbTint="@color/aurora_cyan"
                        android:trackTint="@color/aurora_gray" />

                    <TextView
                        android:id="@+id/antiTheftStatusText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="Off"
                        android:textColor="@color/aurora_warning"
                        android:textSize="14sp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/antiTheftDetailText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Waiting for a 3.5 mm trigger"
                    android:textColor="@color/aurora_silver"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Switch
                        android:id="@+id/antiTheftAttachLocationSwitch"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Attach location in theft alerts"
                        android:textColor="@color/text_primary"
                        android:thumbTint="@color/aurora_cyan"
                        android:trackTint="@color/aurora_gray" />

                    <TextView
                        android:id="@+id/antiTheftAttachLocationStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="On"
                        android:textColor="@color/aurora_cyan"
                        android:textSize="14sp" />

                </LinearLayout>

                <Button
                    android:id="@+id/antiTheftPinButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/aurora_button_ripple"
                    android:text="Set / Change Anti-Theft PIN"
                    android:textColor="@color/white" />

                <Button
                    android:id="@+id/antiTheftSoundButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/aurora_button_ripple"
                    android:text="Choose Alarm Sound"
                    android:textColor="@color/white" />

                <Button
                    android:id="@+id/antiTheftTestButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/aurora_button_ripple"
                    android:text="Test Anti-Theft Alarm"
                    android:textColor="@color/white" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardBackgroundColor="@color/aurora_glass"
            app:cardCornerRadius="18dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Smart Mode"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Switch
                        android:id="@+id/smartModeSwitch"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:thumbTint="@color/aurora_cyan"
                        android:trackTint="@color/aurora_gray" />

                    <TextView
                        android:id="@+id/smartModeStatusText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="Off"
                        android:textColor="@color/aurora_warning"
                        android:textSize="14sp" />

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="นโยบายโหมดฉลาด"
                    android:textColor="@color/aurora_silver"
                    android:textSize="13sp" />

                <RadioGroup
                    android:id="@+id/smartPolicyGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <RadioButton
                        android:id="@+id/policyAutoSendNavOnly"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:paddingVertical="12dp"
                        android:text="ส่งไปจอเฉพาะกรณีเป็นนำทาง" />

                    <RadioButton
                        android:id="@+id/policyAlwaysAsk"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:paddingVertical="12dp"
                        android:text="ถามผู้ใช้ทุกครั้ง" />

                    <RadioButton
                        android:id="@+id/policyAlwaysSend"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:paddingVertical="12dp"
                        android:text="ส่งไปจอทุกครั้ง" />

                    <RadioButton
                        android:id="@+id/policyAlwaysOpenOnPhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:paddingVertical="12dp"
                        android:text="เปิด Maps บนเครื่องหลักทุกครั้ง" />

                </RadioGroup>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="หลังส่งสำเร็จ"
                    android:textColor="@color/aurora_silver"
                    android:textSize="13sp" />

                <RadioGroup
                    android:id="@+id/afterSendGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <RadioButton
                        android:id="@+id/afterSendExit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:paddingVertical="12dp"
                        android:text="ปิดตัวเองและไม่อยู่ Recent" />

                    <RadioButton
                        android:id="@+id/afterSendStay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:paddingVertical="12dp"
                        android:text="ค้างใน PHANToM GO" />

                </RadioGroup>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="หลังส่งสำเร็จ: เปิด Google Maps บนเครื่องหลัก"
                    android:textColor="@color/aurora_silver"
                    android:textSize="13sp" />

                <Switch
                    android:id="@+id/openMapsAfterSendSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:thumbTint="@color/aurora_cyan"
                    android:trackTint="@color/aurora_gray" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardBackgroundColor="@color/aurora_glass"
            app:cardCornerRadius="18dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="4) Logcat / System Logs"
                        android:textColor="@color/aurora_cyan"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/copyLogButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/aurora_button_ripple"
                        android:minWidth="0dp"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="8dp"
                        android:text="Copy"
                        android:textColor="@color/white"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/clearLogButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/aurora_button_ripple"
                        android:minWidth="0dp"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="8dp"
                        android:text="Clear"
                        android:textColor="@color/white"
                        android:textSize="12sp" />

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="ดูสถานะล่าสุดของแอปและคัดลอก log ออกไปตรวจสอบได้จากส่วนนี้"
                    android:textColor="@color/aurora_silver"
                    android:textSize="13sp" />

                <ScrollView
                    android:id="@+id/logScrollView"
                    android:layout_width="match_parent"
                    android:layout_height="260dp"
                    android:layout_marginTop="14dp"
                    android:background="@color/aurora_black"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/logText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="Loading logs..."
                        android:textColor="@color/aurora_silver"
                        android:textSize="12sp" />

                </ScrollView>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
    </ScrollView>
</FrameLayout>
