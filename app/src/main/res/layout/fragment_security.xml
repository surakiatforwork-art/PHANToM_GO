<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/soft_screen_bg">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="126dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="30dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/security_title"
                android:textColor="@color/ui_text_primary"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/securitySubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/security_subtitle"
                android:textColor="@color/ui_text_secondary"
                android:textSize="15sp" />

            <LinearLayout
                android:id="@+id/securityStatusCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/security_safe_card"
                android:elevation="3dp"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_security"
                        app:tint="@color/ui_success" />

                    <TextView
                        android:id="@+id/securityHeadline"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:text="@string/security_ready"
                        android:textColor="@color/ui_text_primary"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/securityStateBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/badge_success"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="7dp"
                        android:text="@string/security_safe"
                        android:textColor="@color/ui_success"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/securityDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/security_waiting_status"
                    android:textColor="@color/ui_text_secondary"
                    android:textSize="15sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSecurityPrimaryAction"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/soft_secondary_button"
                    android:backgroundTint="@null"
                    app:backgroundTint="@null"
                    android:text="@string/security_manage_settings"
                    android:textAllCaps="false"
                    android:textColor="@color/soft_button_secondary_text"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/displaySecurityControls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/soft_card_background"
                android:elevation="3dp"
                android:orientation="vertical"
                android:padding="18dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/security_display_controls"
                    android:textColor="@color/ui_text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/securityJackStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/security_jack_disconnected"
                    android:textColor="@color/ui_text_secondary"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSecurityPinAction"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/soft_secondary_button"
                    android:backgroundTint="@null"
                    android:text="@string/at_set_pin"
                    android:textAllCaps="false"
                    android:textColor="@color/soft_button_secondary_text"
                    android:textStyle="bold"
                    app:backgroundTint="@null" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSecurityAdvancedAction"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/soft_secondary_button"
                    android:backgroundTint="@null"
                    android:text="@string/security_advanced_settings"
                    android:textAllCaps="false"
                    android:textColor="@color/soft_button_secondary_text"
                    android:textStyle="bold"
                    app:backgroundTint="@null" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/findDisplayCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/soft_card_background"
                android:elevation="3dp"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/security_find_display"
                        android:textColor="@color/ui_text_primary"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSecurityRefresh"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:background="@drawable/soft_secondary_button"
                        android:backgroundTint="@null"
                        app:backgroundTint="@null"
                        android:text="@string/security_refresh"
                        android:textAllCaps="false"
                        android:textColor="@color/soft_button_secondary_text"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/displayLocationSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/security_pair_to_see_location"
                    android:textColor="@color/ui_text_secondary"
                    android:textSize="14sp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="310dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/map_placeholder_background"
                    android:padding="1dp">

                    <WebView
                        android:id="@+id/displayLocationMap"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/ui_surface_alt"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/displayLocationPlaceholder"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:padding="28dp"
                        android:text="@string/security_no_location"
                        android:textColor="@color/ui_text_muted"
                        android:textSize="15sp" />
                </FrameLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSecurityOpenExternalMap"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/soft_primary_button"
                    android:backgroundTint="@null"
                    app:backgroundTint="@null"
                    android:text="@string/security_open_in_maps"
                    android:textAllCaps="false"
                    android:textColor="@color/soft_button_primary_text"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Dashcam (GO Cam) -->
            <LinearLayout
                android:id="@+id/dashcamSecurityCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/soft_card_background"
                android:elevation="3dp"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/security_dashcam_title"
                    android:textColor="@color/ui_text_primary"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/dashcamEnableSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/security_dashcam_enable"
                    android:textColor="@color/ui_text_primary"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/dashcamStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/security_dashcam_state_off"
                    android:textColor="@color/ui_warning"
                    android:textSize="14sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/dashcamAutoRecordSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/security_dashcam_autorecord"
                    android:textColor="@color/ui_text_primary"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/security_dashcam_autorecord_hint"
                    android:textColor="@color/ui_text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/dashcamDetailText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/ui_text_secondary"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dashcamGrantButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/soft_secondary_button"
                    android:backgroundTint="@null"
                    app:backgroundTint="@null"
                    android:text="@string/security_dashcam_grant"
                    android:textAllCaps="false"
                    android:textColor="@color/soft_button_secondary_text"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dashcamSecurityViewClipsButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/soft_primary_button"
                    android:backgroundTint="@null"
                    app:backgroundTint="@null"
                    android:text="@string/security_dashcam_view_clips"
                    android:textAllCaps="false"
                    android:textColor="@color/soft_button_primary_text"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
