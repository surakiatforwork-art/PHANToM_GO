<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/aurora_card"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/actionSheetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/relay_sheet_title"
        android:textColor="@color/aurora_cyan"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/actionSheetType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/aurora_silver"
        android:textSize="14sp"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnSendToDisplay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/relay_send_to_display"
        android:textColor="@color/white"
        android:background="@drawable/aurora_button_ripple"
        android:backgroundTint="@null"
        app:backgroundTint="@null"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnSendAndOpenMaps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/relay_send_and_open"
        android:textColor="@color/white"
        android:background="@drawable/aurora_button_ripple"
        android:backgroundTint="@null"
        app:backgroundTint="@null"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnOpenOnPhone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/relay_open_on_phone"
        android:textColor="@color/white"
        android:background="@drawable/aurora_button_ripple"
        android:backgroundTint="@null"
        app:backgroundTint="@null"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnCopyLink"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/relay_copy_link"
        android:textColor="@color/white"
        android:background="@drawable/aurora_button_ripple"
        android:backgroundTint="@null"
        app:backgroundTint="@null"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnCancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/cancel"
        android:textColor="@color/white"
        android:background="@drawable/aurora_button_ripple"
        android:backgroundTint="@null"
        app:backgroundTint="@null" />

</LinearLayout>
