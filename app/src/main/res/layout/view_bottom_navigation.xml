<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottomDock"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/main_bottom_dock"
    android:baselineAligned="false"
    android:elevation="10dp"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingHorizontal="10dp"
    android:paddingTop="10dp"
    android:paddingBottom="18dp">

    <LinearLayout
        android:id="@+id/navHomeAction"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:background="@drawable/bottom_nav_item_idle"
        android:gravity="center"
        android:minHeight="60dp"
        android:orientation="vertical"
        android:paddingHorizontal="8dp"
        android:paddingVertical="10dp">

        <ImageView
            android:id="@+id/navHomeIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_home"
            app:tint="@color/aurora_silver" />

        <TextView
            android:id="@+id/navHomeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Home"
            android:textColor="@color/aurora_silver"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navDisplayAction"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="3dp"
        android:layout_marginEnd="3dp"
        android:layout_weight="1"
        android:background="@drawable/bottom_nav_item_idle"
        android:gravity="center"
        android:minHeight="60dp"
        android:orientation="vertical"
        android:paddingHorizontal="8dp"
        android:paddingVertical="10dp">

        <ImageView
            android:id="@+id/navDisplayIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_display_mode"
            app:tint="@color/aurora_silver" />

        <TextView
            android:id="@+id/navDisplayLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Display"
            android:textColor="@color/aurora_silver"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navSettingsAction"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:background="@drawable/bottom_nav_item_idle"
        android:gravity="center"
        android:minHeight="60dp"
        android:orientation="vertical"
        android:paddingHorizontal="8dp"
        android:paddingVertical="10dp">

        <ImageView
            android:id="@+id/navSettingsIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_settings"
            app:tint="@color/aurora_silver" />

        <TextView
            android:id="@+id/navSettingsLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Settings"
            android:textColor="@color/aurora_silver"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
