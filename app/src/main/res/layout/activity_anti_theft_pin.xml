<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#AA050510"
    android:padding="24dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/antiTheftPinCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        app:cardBackgroundColor="@color/aurora_glass"
        app:cardCornerRadius="24dp"
        app:cardElevation="12dp"
        app:strokeColor="@color/aurora_error"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:minHeight="280dp"
            android:orientation="vertical"
            android:padding="28dp">

            <TextView
                android:id="@+id/antiTheftPinTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/anti_theft_pin_screen_title"
                android:textAlignment="center"
                android:textColor="@color/text_primary"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/antiTheftPinDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:maxWidth="320dp"
                android:text="@string/anti_theft_pin_screen_subtitle"
                android:textAlignment="center"
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/antiTheftPinCountdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/aurora_warning"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/antiTheftPinInput"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_code_block"
                android:gravity="center"
                android:hint="@string/anti_theft_pin_screen_hint"
                android:importantForAutofill="no"
                android:inputType="numberPassword"
                android:maxLength="6"
                android:paddingHorizontal="16dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/antiTheftPinError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:alpha="0"
                android:text="@string/anti_theft_pin_verification_failed"
                android:textColor="@color/aurora_error"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/antiTheftPinConfirm"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="18dp"
                android:text="@string/anti_theft_pin_verify"
                android:textColor="@color/ui_on_primary"
                style="@style/Widget.CarNavRelay.Button" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
