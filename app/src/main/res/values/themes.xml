<resources xmlns:tools="http://schemas.android.com/tools">
  <!-- Daylight Console base theme. Night overrides live in values-night. -->
  <style name="Theme.CarNavRelay" parent="Theme.Material3.DayNight.NoActionBar">
    <item name="colorPrimary">@color/ui_primary</item>
    <item name="colorPrimaryVariant">@color/ui_primary</item>
    <item name="colorOnPrimary">@color/ui_on_primary</item>
    <item name="colorPrimaryContainer">@color/ui_primary_container</item>
    <item name="colorOnPrimaryContainer">@color/ui_text_primary</item>

    <!-- Secondary Colors -->
    <item name="colorSecondary">@color/ui_success</item>
    <item name="colorSecondaryVariant">@color/ui_success</item>
    <item name="colorOnSecondary">@color/ui_on_primary</item>
    <item name="colorSecondaryContainer">@color/ui_surface_alt</item>
    <item name="colorOnSecondaryContainer">@color/ui_text_primary</item>

    <!-- Surface Colors -->
    <item name="colorSurface">@color/ui_surface</item>
    <item name="colorOnSurface">@color/ui_text_primary</item>
    <item name="android:colorBackground">@color/ui_background</item>
    <item name="colorOnBackground">@color/ui_text_primary</item>

    <!-- Error Colors -->
    <item name="colorError">@color/ui_danger</item>
    <item name="colorOnError">@color/ui_on_primary</item>

    <!-- System Bars -->
    <item name="android:statusBarColor">@color/ui_background</item>
    <item name="android:navigationBarColor">@color/navy</item>
    <item name="android:windowLightStatusBar">true</item>

    <!-- Shape Appearance -->
    <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.CarNavRelay.SmallComponent</item>
    <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.CarNavRelay.MediumComponent</item>
    <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.CarNavRelay.LargeComponent</item>

    <!-- Default Card Style -->
    <item name="materialCardViewStyle">@style/Widget.CarNavRelay.CardView</item>
    <item name="materialButtonStyle">@style/Widget.CarNavRelay.Button</item>
    <item name="materialSwitchStyle">@style/Widget.CarNavRelay.Switch</item>
  </style>

  <!-- Shape Appearances -->
  <style name="ShapeAppearance.CarNavRelay.SmallComponent" parent="ShapeAppearance.Material3.SmallComponent">
    <item name="cornerFamily">rounded</item>
    <item name="cornerSize">8dp</item>
  </style>

  <style name="ShapeAppearance.CarNavRelay.MediumComponent" parent="ShapeAppearance.Material3.MediumComponent">
    <item name="cornerFamily">rounded</item>
    <item name="cornerSize">16dp</item>
  </style>

  <style name="ShapeAppearance.CarNavRelay.LargeComponent" parent="ShapeAppearance.Material3.LargeComponent">
    <item name="cornerFamily">rounded</item>
    <item name="cornerSize">24dp</item>
  </style>

  <!-- Card Style -->
  <style name="Widget.CarNavRelay.CardView" parent="Widget.Material3.CardView.Elevated">
    <item name="cardElevation">3dp</item>
    <item name="cardCornerRadius">16dp</item>
    <item name="cardBackgroundColor">@color/ui_surface</item>
    <item name="strokeColor">@color/ui_outline</item>
    <item name="strokeWidth">1dp</item>
  </style>

  <!-- Button Styles -->
  <style name="Widget.CarNavRelay.Button" parent="Widget.Material3.Button">
    <item name="cornerRadius">12dp</item>
    <item name="android:textSize">16sp</item>
    <item name="android:textStyle">bold</item>
    <item name="android:textColor">@color/ui_on_primary</item>
    <item name="android:scaleY">1.0</item>
    <item name="android:scaleX">1.0</item>
  </style>

  <!-- Translucent Theme for RelayActivity -->
  <style name="Theme.CarNavRelay.Translucent" parent="Theme.CarNavRelay">
    <item name="android:windowIsTranslucent">true</item>
    <item name="android:windowBackground">@android:color/transparent</item>
    <item name="android:windowContentOverlay">@null</item>
    <item name="android:windowNoTitle">true</item>
    <item name="android:backgroundDimEnabled">false</item>
  </style>

  <style name="Widget.CarNavRelay.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
    <item name="android:minWidth">52dp</item>
    <item name="android:minHeight">48dp</item>
  </style>

  <style name="Theme.CarNavRelay.SecurityOverlay" parent="Theme.CarNavRelay.Translucent">
    <item name="android:backgroundDimEnabled">true</item>
    <item name="android:windowCloseOnTouchOutside">false</item>
    <item name="android:statusBarColor">@android:color/transparent</item>
    <item name="android:navigationBarColor">@android:color/transparent</item>
  </style>

  <!-- NoDisplay Theme for SilentShareReceiverActivity -->
  <style name="Theme.CarNavRelay.NoDisplay" parent="Theme.CarNavRelay.Translucent">
    <item name="android:windowNoDisplay">true</item>
    <item name="android:windowDisablePreview">true</item>
  </style>
</resources>
