<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <gradient
                android:angle="0"
                android:startColor="@color/soft_primary_fill_disabled"
                android:endColor="@color/soft_primary_fill_disabled_end" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <ripple android:color="#40FFFFFF">
            <item>
                <shape>
                    <gradient
                        android:angle="0"
                        android:startColor="@color/soft_blue"
                        android:endColor="@color/soft_blue_end" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
        </ripple>
    </item>
</selector>
