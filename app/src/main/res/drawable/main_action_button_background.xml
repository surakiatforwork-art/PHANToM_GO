<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <solid android:color="#4420283F" />
            <corners android:radius="24dp" />
            <stroke
                android:width="1dp"
                android:color="#2222D3EE" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:angle="135"
                android:endColor="#FF14192F"
                android:startColor="#FF202747"
                android:type="linear" />
            <corners android:radius="24dp" />
            <stroke
                android:width="1dp"
                android:color="#4D22D3EE" />
        </shape>
    </item>
</selector>
